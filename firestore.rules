rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is the root admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == "sarkarpabitra1510@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    // Is a logged-in student (must be email verified)
    function isStudent() {
      return request.auth != null && 
             (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == "google.com");
    }

    // ==== ADMIN ACCESS ====
    // Admins have full access to everything by default
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ==== SETTINGS ACCESS ====
    match /settings/{document} {
      // Allows the website to check if maintenance is ON before a user logs in
      allow read: if true; 
      // Only admin can change public settings
      allow write: if isAdmin();
    }

    // ==== STUDENT ACCESS ====
    
    match /resources/{resourceId} {
      // Students can only see visible resources
      allow read: if isStudent() && (!("visible" in resource.data) || resource.data.visible == true);
    }

    match /notices/{noticeId} {
      // Students can only see visible notices
      allow read: if isStudent() && (!("visible" in resource.data) || resource.data.visible == true);
    }
    
    match /users/{userId} {
      // Users can manage their own profile
      allow read, create: if request.auth != null && request.auth.uid == userId;
      // Prevent users from changing their own role or sensitive fields
      allow update: if request.auth != null && request.auth.uid == userId 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'uid']));
    }
  }
}
