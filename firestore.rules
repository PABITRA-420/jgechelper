rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
 
    // Helper function to check if user is the root admin OR a promoted admin
    // This allows users marked as "admin" in the Firestore users collection to actually manage content
    function isAdmin() {
      let isRoot = request.auth != null && 
             request.auth.token.email == "sarkarpabitra1510@gmail.com" &&
             request.auth.token.email_verified == true;
             
      let isDbAdmin = request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
             
      return isRoot || isDbAdmin;
    }

    // Is a logged-in student (must be email verified)
    function isStudent() {
      return request.auth != null && 
             (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == "google.com");
    }

    // ==== ADMIN ACCESS ====
    // Admins have full access to everything by default
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ==== SETTINGS ACCESS ====
    match /settings/{document} {
      // Allows the website to check if maintenance is ON before a user logs in
      allow read: if true; 
      // Only admin can change public settings
      allow write: if isAdmin();
    }

    // ==== STUDENT ACCESS ====
    
    match /resources/{resourceId} {
      // ==== OLD LOGIC (Commented out for reference) ====
      // Students can only see visible resources
      // allow read: if isStudent() && (!("visible" in resource.data) || resource.data.visible == true);

      // ==== NEW LOGIC ====
      // Students can only see visible resources that are NOT soft-deleted
      allow read: if isStudent() && 
                  (!("visible" in resource.data) || resource.data.visible == true) &&
                  (!("isDeleted" in resource.data) || resource.data.isDeleted == false);
    }

    match /notices/{noticeId} {
      // Students can only see visible notices
      allow read: if isStudent() && (!("visible" in resource.data) || resource.data.visible == true);
    }
    
    match /users/{userId} {
      // Users can manage their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId 
                    && (request.resource.data.role == "user" || 
                       (request.resource.data.role == "admin" && request.auth.token.email == "sarkarpabitra1510@gmail.com"));
      // Prevent users from changing their own role or sensitive fields
      allow update: if request.auth != null && request.auth.uid == userId 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'uid']));
    }
  }
}
